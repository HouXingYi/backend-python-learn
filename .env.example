DATABASE_URL=mysql+pymysql://app_user:app_password@127.0.0.1:3306/backend_learn
AUTO_CREATE_TABLES=true

# mock: 本地无 key 时使用模拟流式回复；litellm: 通过 LiteLLM 网关调用真实模型
AGENT_MODE=mock
LITELLM_API_KEY=
LITELLM_BASE_URL=https://llm-developer.fzzixun.com/v1
LITELLM_MODEL_NAME=claude-sonnet-4-6
LITELLM_THINKING=
LITELLM_TIMEOUT_SECONDS=20
